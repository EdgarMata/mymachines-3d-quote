# Public build-input allowlist. Re-exclude each directory before allowing files:
# Docker directory negations otherwise re-include all descendants.
**
!backend/
backend/**
!backend/Dockerfile
!backend/requirements.txt
!backend/app/
backend/app/**
!backend/app/*.py
!backend/app/services/
backend/app/services/**
!backend/app/services/*.py
!config/
config/**
!config/printing.json
!config/pricing.demo.json
!profiles/
profiles/**
!profiles/README.md
!profiles/filaments/
profiles/filaments/**
!profiles/filaments/generic_pla.json
!profiles/filaments/mymachines_pla.json
!profiles/filaments/mymachines_petg.json
!profiles/printers/
profiles/printers/**
!profiles/printers/my_cloner_04.json
!profiles/printers/prusa_mk3s_0.4.json
!profiles/processes/
profiles/processes/**
!profiles/processes/draft.json
!profiles/processes/standard.json
!profiles/processes/fine.json
!profiles/processes/quality_0.20_mk3s.json
!frontend/
frontend/**
!frontend/Dockerfile
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/nginx.conf
!frontend/nginx-trusted-proxies.conf
!frontend/15-validate-trusted-proxies.sh
!frontend/src/
frontend/src/**
!frontend/src/*.ts
!frontend/src/*.tsx
!frontend/src/*.css
!frontend/src/components/
frontend/src/components/**
!frontend/src/components/*.tsx
!frontend/src/assets/
frontend/src/assets/**
!frontend/src/assets/*.svg
!frontend/src/assets/*.png
!frontend/public/
frontend/public/**
!frontend/public/*.svg
!third_party/
third_party/**
!third_party/orcaslicer/
third_party/orcaslicer/**
!third_party/orcaslicer/LICENSE.txt
!third_party/orcaslicer/SOURCE.md
!LICENSE
!THIRD_PARTY_NOTICES.md
# Defense in depth within allowed code directories.
**/__pycache__/
**/*.private.json
**/*.local.json
**/private/
**/secrets/
**/.env
**/.env.*
**/*.pem
**/*.key
